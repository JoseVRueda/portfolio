---
import { siGithub } from "simple-icons";
import Section from "./Section.astro";
import { profile } from "../data/profile";
import { getDictionary, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();
---

<Section id="contact" index="06" title={t.contact.heading}>
  <p class="max-w-xl text-lg leading-relaxed text-muted">{t.contact.lead}</p>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    <li class="rounded-2xl border border-white/10 bg-surface p-5">
      <p class="flex items-center gap-2 text-sm text-muted">
        <svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="M3 7l9 6 9-6"></path>
        </svg>
        {t.contact.email}
      </p>
      <a class="mt-2 inline-block font-medium break-all text-primary-text hover:underline" href={`mailto:${profile.email}`}>
        {profile.email}
      </a>
    </li>
    <li class="rounded-2xl border border-white/10 bg-surface p-5">
      <p class="flex items-center gap-2 text-sm text-muted">
        <svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 3h3l2 5-2 1a12 12 0 0 0 5 5l1-2 5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 5 5a2 2 0 0 1 2-2z"></path>
        </svg>
        {t.contact.phone}
      </p>
      <a class="mt-2 inline-block font-medium text-primary-text hover:underline" href={profile.phoneHref}>
        {profile.phoneDisplay}
      </a>
    </li>
    <li class="rounded-2xl border border-white/10 bg-surface p-5">
      <p class="flex items-center gap-2 text-sm text-muted">
        <svg viewBox="0 0 24 24" class="size-4 shrink-0" aria-hidden="true">
          <path
            fill="currentColor"
            d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45C23.2 24 24 23.23 24 22.27V1.73C24 .77 23.2 0 22.23 0z"
          ></path>
        </svg>
        {t.hero.linkedin}
      </p>
      <a
        class="mt-2 inline-block font-medium text-primary-text hover:underline"
        href={profile.links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        linkedin.com/in/josevrueda
      </a>
    </li>
    <li class="rounded-2xl border border-white/10 bg-surface p-5">
      <p class="flex items-center gap-2 text-sm text-muted">
        <svg viewBox="0 0 24 24" class="size-4 shrink-0" aria-hidden="true">
          <path fill="currentColor" d={siGithub.path}></path>
        </svg>
        {t.hero.github}
      </p>
      <a
        class="mt-2 inline-block font-medium text-primary-text hover:underline"
        href={profile.links.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        github.com/JoseVRueda
      </a>
    </li>
  </ul>
</Section>

<footer class="border-t border-white/10">
  <div class="mx-auto flex max-w-5xl flex-col gap-2 px-5 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {profile.name}</p>
    <p>{profile.location.city}, {profile.location.country}</p>
  </div>
</footer>
