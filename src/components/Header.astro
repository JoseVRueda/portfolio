---
import { getRelativeLocaleUrl } from "astro:i18n";
import { profile } from "../data/profile";
import { getDictionary, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const enHref = getRelativeLocaleUrl("en");
const esHref = getRelativeLocaleUrl("es");

const links = [
  { href: "#about", label: t.nav.about },
  { href: "#experience", label: t.nav.experience },
  { href: "#skills", label: t.nav.skills },
  { href: "#projects", label: t.nav.projects },
  { href: "#education", label: t.nav.education },
  { href: "#contact", label: t.nav.contact },
];

const languages = [
  { code: "en" as const, href: enHref, label: "EN" },
  { code: "es" as const, href: esHref, label: "ES" },
];
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-white/10 bg-ink/95 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center gap-4 px-5">
    <a
      href={locale === "en" ? enHref : esHref}
      class="inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-primary/70 bg-primary/10 font-display text-xs font-semibold tracking-tight text-primary-text"
    >
      JR
      <span class="sr-only">{profile.name}</span>
    </a>
    <nav aria-label={t.nav.language} class="ml-auto flex items-center gap-2 text-sm font-semibold md:ml-0">
      {
        languages.map((language) => (
          <a
            href={language.href}
            hreflang={language.code}
            lang={language.code}
            data-lang-switch
            data-lang-base={language.href}
            aria-current={language.code === locale ? "true" : undefined}
            class:list={[
              "rounded-full px-2 py-1",
              language.code === locale ? "text-primary-text" : "text-muted hover:text-text",
            ]}
          >
            {language.label}
          </a>
        ))
      }
    </nav>
    <nav aria-label={t.nav.label} class="ml-auto hidden items-center gap-x-4 text-sm md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-nav
            class="group relative shrink-0 px-0.5 py-1 text-muted hover:text-text data-[active]:text-text"
          >
            {link.label}
            <span
              class="pointer-events-none absolute -bottom-0.5 left-1/2 h-0.5 w-4 -translate-x-1/2 rounded-full bg-primary opacity-0 group-hover:opacity-100 group-data-[active]:opacity-100"
              aria-hidden="true"
            ></span>
          </a>
        ))
      }
    </nav>
    <button
      type="button"
      class="inline-flex size-10 items-center justify-center rounded-full text-text md:hidden"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label={t.nav.openMenu}
      data-label-open={t.nav.openMenu}
      data-label-close={t.nav.closeMenu}
    >
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>
</header>

<div
  id="site-menu"
  data-menu
  class="group pointer-events-none fixed inset-0 z-50 md:hidden"
  inert
  aria-hidden="true"
>
  <div
    data-menu-close
    class="absolute inset-0 bg-black/60 opacity-0 pointer-events-none transition-opacity duration-200 group-data-[open]:pointer-events-auto group-data-[open]:opacity-100"
  ></div>
  <div
    data-menu-panel
    role="dialog"
    aria-modal="true"
    aria-label={t.nav.label}
    class="pointer-events-none absolute inset-y-0 right-0 flex w-72 max-w-[85vw] translate-x-full flex-col border-l border-white/10 bg-surface shadow-2xl transition-transform duration-200 group-data-[open]:pointer-events-auto group-data-[open]:translate-x-0"
  >
    <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
      <p class="font-display text-sm font-semibold tracking-wide text-primary-text">{t.nav.label}</p>
      <button
        type="button"
        data-menu-close
        class="inline-flex size-10 items-center justify-center rounded-full text-text"
        aria-label={t.nav.closeMenu}
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
    <nav aria-label={t.nav.label} class="flex flex-col px-5 py-4">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-nav
            data-menu-close
            class="group/item relative py-3 text-lg text-muted hover:text-text data-[active]:text-text"
          >
            {link.label}
            <span
              class="pointer-events-none absolute bottom-2 left-0 h-0.5 w-4 rounded-full bg-primary opacity-0 group-hover/item:opacity-100 group-data-[active]/item:opacity-100"
              aria-hidden="true"
            ></span>
          </a>
        ))
      }
    </nav>
  </div>
</div>

<script>
  const sectionIds = ["about", "experience", "skills", "projects", "education", "contact"];
  const header = document.querySelector("header");
  const languageLinks = document.querySelectorAll<HTMLAnchorElement>("[data-lang-switch]");
  const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-nav]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const desktop = window.matchMedia("(min-width: 768px)");

  function currentSection(): string {
    const line = (header?.getBoundingClientRect().height ?? 64) + 16;
    let active = "";
    for (const id of sectionIds) {
      const section = document.getElementById(id);
      if (!section) continue;
      if (section.getBoundingClientRect().top <= line) active = id;
    }
    return active;
  }

  function syncNavigation() {
    const active = currentSection();
    for (const link of languageLinks) {
      const base = link.dataset.langBase ?? link.pathname;
      link.href = active ? `${base}#${active}` : base;
    }
    for (const link of navLinks) {
      const id = link.getAttribute("href")?.replace("#", "");
      const on = id === active;
      link.toggleAttribute("data-active", on);
      if (on) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    }
  }

  function setMenu(open: boolean, restoreFocus = true) {
    if (!menu || !toggle) return;
    menu.toggleAttribute("data-open", open);
    menu.toggleAttribute("inert", !open);
    menu.setAttribute("aria-hidden", open ? "false" : "true");
    toggle.setAttribute("aria-expanded", String(open));
    const label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
    if (label) toggle.setAttribute("aria-label", label);
    document.body.style.overflow = open ? "hidden" : "";
    if (open) {
      menu.querySelector<HTMLButtonElement>("[data-menu-panel] button")?.focus();
    } else if (restoreFocus) {
      toggle.focus({ preventScroll: true });
    }
  }

  toggle?.addEventListener("click", () => {
    setMenu(!menu?.hasAttribute("data-open"));
  });

  menu?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const closer = target.closest("[data-menu-close]");
    if (!closer) return;
    setMenu(false, !(closer instanceof HTMLAnchorElement));
  });

  document.addEventListener("keydown", (event) => {
    if (!menu?.hasAttribute("data-open")) return;
    if (event.key === "Escape") {
      setMenu(false);
      return;
    }
    if (event.key !== "Tab" || !menu) return;
    const focusable = [...menu.querySelectorAll<HTMLElement>("a[href], button")];
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (!first || !last) return;
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  desktop.addEventListener("change", (event) => {
    if (event.matches) setMenu(false, false);
  });

  syncNavigation();
  document.addEventListener("scroll", syncNavigation, { passive: true });
  window.addEventListener("hashchange", syncNavigation);
</script>
