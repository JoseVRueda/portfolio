---
import { siGithub } from "simple-icons";
import { profile } from "../data/profile";
import { getDictionary, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const place = `${profile.location.city}, ${profile.location.region}, ${profile.location.country}`;
---

<section class="relative pt-28 pb-16 md:pt-36 md:pb-20">
  <div class="relative mx-auto grid max-w-5xl items-center gap-6 px-5 lg:grid-cols-[minmax(0,1.2fr)_minmax(220px,22rem)] lg:gap-10">
    <div>
      <div class="flex items-center gap-4">
        <img
          src="/portrait.png"
          alt={t.hero.portrait}
          width="433"
          height="577"
          class="size-16 shrink-0 rounded-full object-cover object-[center_16%] ring-2 ring-primary/70 lg:hidden"
        />
        <p class="text-sm font-semibold tracking-[0.18em] text-primary-text uppercase">{t.meta.jobTitle}</p>
      </div>
      <h1 class="mt-4 font-display text-5xl leading-[0.95] font-semibold tracking-tight text-balance md:text-7xl">
        Jose Vicente<br />Rueda Rueda
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{t.hero.summary}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={`mailto:${profile.email}`}
          class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#be123c]"
        >
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3 7l9 6 9-6"></path>
          </svg>
          {t.hero.email}
        </a>
        <a
          href={profile.links.linkedin}
          class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold hover:border-primary hover:text-primary-text"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true">
            <path
              fill="currentColor"
              d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45C23.2 24 24 23.23 24 22.27V1.73C24 .77 23.2 0 22.23 0z"
            ></path>
          </svg>
          {t.hero.linkedin}
        </a>
        <a
          href={profile.links.github}
          class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold hover:border-primary hover:text-primary-text"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true">
            <path fill="currentColor" d={siGithub.path}></path>
          </svg>
          {t.hero.github}
        </a>
      </div>
      <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-4 text-sm">
        <div>
          <dt class="text-muted">{t.hero.locationLabel}</dt>
          <dd class="mt-1 font-medium">{place}</dd>
        </div>
        <div>
          <dt class="text-muted">{t.contact.email}</dt>
          <dd class="mt-1">
            <a class="font-medium text-primary-text hover:underline" href={`mailto:${profile.email}`}>
              {profile.email}
            </a>
          </dd>
        </div>
        <div>
          <dt class="text-muted">{t.contact.phone}</dt>
          <dd class="mt-1">
            <a class="font-medium text-primary-text hover:underline" href={profile.phoneHref}>{profile.phoneDisplay}</a>
          </dd>
        </div>
      </dl>
    </div>
    <figure class="hidden lg:block">
      <img
        src="/portrait.png"
        alt={t.hero.portrait}
        width="433"
        height="577"
        class="portrait-fade mx-auto h-[26rem] w-full object-contain object-center"
      />
    </figure>
  </div>
</section>
