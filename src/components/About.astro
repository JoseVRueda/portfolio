---
import Section from "./Section.astro";
import { getDictionary, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<Section id="about" index="01" title={t.about.heading}>
  <div class="max-w-3xl space-y-5 text-base leading-relaxed text-muted md:text-lg">
    {t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</Section>
