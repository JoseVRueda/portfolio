---
import Section from "./Section.astro";
import { projects } from "../data/profile";
import { getDictionary, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<Section id="projects" index="04" title={t.projects.heading}>
  <div class="grid gap-5 md:grid-cols-2">
    {
      projects.map((project) => (
        <article class="flex flex-col rounded-2xl border border-white/10 bg-surface p-6 md:p-8">
          <h3 class="font-display text-2xl font-semibold tracking-tight md:text-3xl">{project.name}</h3>
          <p class="mt-3 flex-1 leading-relaxed text-muted">{t.projects.items[project.id]}</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {project.stack.map((item) => (
              <li class="rounded-full border border-white/10 px-3 py-1 text-xs tracking-wide text-text/90">{item}</li>
            ))}
          </ul>
          <div class="mt-6 flex flex-wrap gap-4 text-sm font-semibold">
            <a class="text-primary-text hover:underline" href={project.demo} target="_blank" rel="noopener noreferrer">
              {t.projects.demo}
            </a>
            <a class="text-primary-text hover:underline" href={project.repo} target="_blank" rel="noopener noreferrer">
              {t.projects.source}
            </a>
          </div>
        </article>
      ))
    }
  </div>
</Section>
